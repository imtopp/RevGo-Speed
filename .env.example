DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"
# Jangan isi AUTH_URL â€” auth sudah pakai trustHost (src/lib/auth.ts).
# Mengisi AUTH_URL justru memaksa redirect ke host itu dan memutus akses via IP LAN.
# AUTH_URL="http://localhost:3000"

# Seed per instance (opsional â€” prisma/seed.ts; default domain revgo-speed.id;
# contoh instance TBRT: owner@tbrt.com / sysadmin@tbrt.com)
# SEED_OWNER_EMAIL="owner@tbrt.com"
# SEED_SYSADMIN_EMAIL="sysadmin@tbrt.com"

# Sembunyikan group motor listrik di dropdown merek (per instance).
# Set "true" di project Vercel bengkel yang tidak menangani motor listrik
# (contoh: TBRT). Tidak diset â†’ group Listrik tampil (default).
# HIDE_EV_MEREK=true

# Web Push (notifikasi native-like) — VAPID key pair. Server-only:
# generate secret: node -e "const w=require('web-push');console.log(JSON.stringify(w.generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""   # public key (boleh terbit, dipakai browser)
# VAPID_PRIVATE_KEY=""             # PRIVATE key — hanya env Vercel, jangan commit!
